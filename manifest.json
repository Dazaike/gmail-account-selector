{
  "manifest_version": 3,
  "name": "Gmail Account Selector",
  "version": "1.2.0",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "picker.html?view=popup",
    "default_title": "Choose Gmail account"
  },
  "commands": {
    "open-picker": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Open the Gmail account picker"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://example.com/*",
    "https://mail.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://example.com/BDKWHW7"],
      "js": ["src/redirect.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://mail.google.com/mail/u/*"],
      "js": ["src/discover.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["picker.html"],
      "matches": ["https://example.com/*"]
    }
  ]
}
